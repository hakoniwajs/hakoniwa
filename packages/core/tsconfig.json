{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // ランタイム非依存 (node:*/cloudflare:* 禁止) のため、@types/node 等のアンビエント型を
    // 暗黙に取り込まない (node/cloudflare の tsconfig.json と同様の方針)。
    // CompressionStream/Response 等 Web 標準の型を使う箇所 (tmp/17-ogp.md) が、@types/node の
    // Buffer 拡張と Uint8Array<ArrayBufferLike> の不整合で型エラーにならないようにする。
    "types": []
  },
  "include": ["src"]
}
