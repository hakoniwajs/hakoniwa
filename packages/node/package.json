{
  "name": "@hakoniwajs/node",
  "version": "0.1.4",
  "description": "箱庭諸島２ (TypeScript 版) の Node.js アダプタ。`hakoniwa serve` で node:sqlite をストレージにした HTTP サーバーが起動する",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakoniwajs/hakoniwa.git",
    "directory": "packages/node"
  },
  "bin": {
    "hakoniwa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@hakoniwajs/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "24.13.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
