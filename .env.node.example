# このファイルを .env にコピーして値を設定してください。
# mise 経由 (activate 済みシェルや `mise exec`) であれば、リポジトリ直下の .env は自動的に読み込まれます。
# 環境変数を変更したら開発サーバーを起動し直してください。

# better-auth の secret と CSRF トークンの鍵 (任意、32 バイト以上のランダム文字列)。
# 未設定なら初回起動時に自動生成して DB (settings 表) に保存し、以後はそれを使います。
# 明示したい場合の生成例: openssl rand -base64 32
# HAKONIWA_AUTH_SECRET=

# サイトの URL。省略可能 (未設定ならリクエストから自動判定します)。
# OAuth のコールバック URL や Origin 検査の基準を明示したい (カスタムドメインや
# 逆プロキシ配下で動かす) 場合だけ設定してください。
# HAKONIWA_BASE_URL=http://localhost:5173

# true にすると開発ログイン (任意のメールアドレスでログインできる機能) が有効になります。
# 本番環境では絶対に有効にしないでください。
HAKONIWA_DEV_LOGIN=true

# 管理者とみなすメールアドレス (カンマ区切り)。開発ログインでこのメールを使うと管理者になれます。
# 未設定でも、ログインして /admin/setup を開き、コンソールに出力されるセットアップコードを
# 入力すれば最初の管理者になれます (以後は管理画面から管理者を追加・削除できます)。
HAKONIWA_ADMIN_EMAILS=you@example.com

# true にするとトップページに「ターンを進める」ボタンが表示されます (管理者のみ、開発用)。
# HAKONIWA_DEBUG=true

# X (Twitter) / Discord ログイン。ID と secret の両方が揃った方法だけ有効化できます。
# OAuth アプリ側のコールバック URL: <公開 URL>/api/auth/callback/twitter, .../callback/discord
# HAKONIWA_X_CLIENT_ID=
# HAKONIWA_X_CLIENT_SECRET=
# HAKONIWA_DISCORD_CLIENT_ID=
# HAKONIWA_DISCORD_CLIENT_SECRET=

# メール送信 (Resend)。未設定の場合はログにリンクを出力するだけの開発用 Mailer になります。
# HAKONIWA_RESEND_API_KEY=
# HAKONIWA_MAIL_FROM=hakoniwa@example.com

# サイトタイトル・フッタ情報 (管理者名・メール・掲示板・トップページ)・追加の NG ワード・
# ローカル掲示板の有無・タイムゾーンは、管理画面 (/admin) の「サイト設定」で変更します。
# 1 ターンの長さ・開始時刻・最終ターンは「新しいゲームを開始」フォーム (または CLI の
# game new / db init のオプション) で指定します。

# Node サーバーの設定
# PORT=3000
# HAKONIWA_DB_PATH=./data/hakoniwa.sqlite
# HAKONIWA_BACKUP_DIR=./data/backups
# HAKONIWA_TURN_CHECK_INTERVAL_SEC=60
